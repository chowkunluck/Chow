import 'dart:io';
import 'package:flutter/material.dart';
import 'package:http/http.dart' as http;
import 'package:image_picker/image_picker.dart';

class AnalyzePage extends StatefulWidget {
  @override
  _AnalyzePageState createState() => _AnalyzePageState();
}

class _AnalyzePageState extends State<AnalyzePage> {
  final ImagePicker _picker = ImagePicker();
  String _result = '';

  Future<void> _captureAndAnalyze() async {
    // ถ่ายภาพด้วยกล้อง
    final XFile? image = await _picker.pickImage(source: ImageSource.camera);
    if (image == null) return;

    // ส่งภาพไป Backend FastAPI
    var request = http.MultipartRequest(
      'POST',
      Uri.parse('https://your-backend-url.com/analyze'), // ใส่ URL Backend ที่ Deploy แล้ว
    );
    // ใส่ JWT Token ใน Header
    request.headers['Authorization'] = 'Bearer YOUR_JWT_TOKEN';
    request.files.add(await http.MultipartFile.fromPath('file', image.path));

    var response = await request.send();
    if (response.statusCode == 200) {
      // อ่านผลลัพธ์ JSON
      final responseData = await response.stream.bytesToString();
      setState(() {
        _result = responseData;
      });
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text('วิเคราะห์ใบงาน')),
      body: Center(
        child: Column(
          children: [
            ElevatedButton(
              onPressed: _captureAndAnalyze,
              child: Text('ถ่ายภาพและวิเคราะห์'),
            ),
            SizedBox(height: 20),
            Text(_result),
          ],
        ),
      ),
    );
  }
}